<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>CPIK - CyClone Power Icon Kit</title>
  <meta name="description" content="کیت CPIK آیکون بانک‌ها، پلتفرم‌ها، سرویس‌ها و برندهای ایرانی را یک‌جا می‌دهد. یک فایل استایل را لینک کنید تا هر آیکون با یک نام کلاس در دسترس باشد.">
  <meta name="color-scheme" content="dark light">
  <link rel="icon" href="assets/favicon/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="assets/favicon/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="assets/favicon/apple-touch-icon.png">
  <link rel="manifest" href="assets/favicon/site.webmanifest">
  <script>
    (() => {
      const root = document.documentElement;
      let theme = 'dark';

      try {
        const savedTheme = localStorage.getItem('cpik-preview-theme');

        if (savedTheme === 'dark' || savedTheme === 'light') {
          theme = savedTheme;
        }
      } catch { }

      root.dataset.theme = theme;
    })();
  </script>
  <link rel="stylesheet" href="{{ name }}.css">
  <style>
    @font-face {
      font-family: "Vazirmatn";
      src: url("assets/fonts/Vazirmatn-Regular.ttf") format("truetype");
      font-weight: 400;
      font-display: swap;
    }

    @font-face {
      font-family: "Vazirmatn";
      src: url("assets/fonts/Vazirmatn-Medium.ttf") format("truetype");
      font-weight: 500;
      font-display: swap;
    }

    @font-face {
      font-family: "Vazirmatn";
      src: url("assets/fonts/Vazirmatn-Bold.ttf") format("truetype");
      font-weight: 700;
      font-display: swap;
    }

    /*
     * CPIK palette (CPBS, approved 2026-10-23). Ink and Paper carry the
     * page, Lazuli is the single accent, Grid gray is for keylines only.
     * Muted text uses Grid gray mixed toward the text colour so small
     * captions stay above 4.5:1.
     */
    :root {
      --cpik-ink: #15171C;
      --cpik-paper: #F4F2EC;
      --cpik-lazuli: #4A5CF0;
      --cpik-grid: #777C86;

      --bg: var(--cpik-ink);
      --fg: var(--cpik-paper);
      --surface: #1D2027;
      --surface-hover: #252933;
      --muted: #A3A5AA;
      --line: #2E323B;
      --keyline: var(--cpik-grid);
      --accent: var(--cpik-lazuli);
      --on-accent: var(--cpik-paper);
      --accent-text: #8E9AF7;
      --header-bg: var(--cpik-ink);
      --header-fg: var(--cpik-paper);
      --header-line: #2E323B;
      --control-line: #3A3F49;
      --control-hover: #252933;
      --code-bg: #0F1115;
      --code-fg: var(--cpik-paper);
      --code-muted: #A3A5AA;
      --code-line: #3A3F49;

      --gutter: clamp(1rem, 3vw, 2.5rem);
      --gap: clamp(0.75rem, 1.5vw, 1.25rem);
      --block: clamp(2rem, 4vw, 3.5rem);
      --measure: 42rem;
      --radius: 0.75rem;
      --fs: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem);
      --fs-s: clamp(0.8125rem, 0.78rem + 0.15vw, 0.9375rem);
      --fs-h1: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
      --fs-h2: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
      --fs-h3: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    }

    [data-theme="light"] {
      --bg: var(--cpik-paper);
      --fg: var(--cpik-ink);
      --surface: #FFFFFF;
      --surface-hover: #FBFAF7;
      --muted: #5E636C;
      --line: #D9D6CE;
      --accent-text: var(--cpik-lazuli);
      --header-bg: var(--cpik-paper);
      --header-fg: var(--cpik-ink);
      --header-line: #D9D6CE;
      --control-line: #D9D6CE;
      --control-hover: #EAE7DF;
      --code-bg: var(--cpik-paper);
      --code-fg: var(--cpik-ink);
      --code-muted: #5E636C;
      --code-line: #D9D6CE;
    }

    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      background: var(--bg);
      color: var(--fg);
      -webkit-text-size-adjust: 100%;
      scroll-behavior: smooth;
      scroll-padding-top: 5.5rem;
    }

    body {
      margin: 0;
      background: var(--bg);
      font-family: "Vazirmatn", Tahoma, sans-serif;
      font-size: var(--fs);
      line-height: 1.8;
      overflow-x: hidden;
    }

    h1, h2, h3 {
      margin: 0;
      line-height: 1.35;
      font-weight: 700;
      text-wrap: balance;
    }

    p, pre, figure {
      margin: 0;
    }

    a {
      color: var(--accent-text);
      text-underline-offset: 0.2em;
    }

    a:hover {
      color: var(--fg);
    }

    :focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 2px;
    }

    bdi {
      unicode-bidi: isolate;
    }

    code, pre {
      font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
      direction: ltr;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .wrap {
      max-width: 1200px;
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .ui-icon {
      width: 1.15rem;
      height: 1.15rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      flex: none;
    }

    /* Header: follows the theme; the lockup takes its frame and letters from the text colour. */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: var(--header-bg);
      color: var(--header-fg);
      border-bottom: 1px solid var(--header-line);
    }

    .site-header .wrap {
      display: flex;
      align-items: center;
      gap: 1rem 1.5rem;
      min-height: 4.25rem;
      flex-wrap: wrap;
      padding-block: 0.6rem;
    }

    .brand {
      display: flex;
      color: inherit;
      text-decoration: none;
    }

    .brand svg {
      display: block;
      height: 32px;
      width: auto;
    }

    /* Narrow screens show the symbol alone. */
    .brand .brand-symbol {
      display: none;
    }

    .brand .tile {
      fill: var(--cpik-lazuli);
    }

    /* The nav sits next to the logo (on the right in Persian); the buttons take the far end. */
    .site-nav {
      display: flex;
      gap: 1.25rem;
      font-size: var(--fs-s);
      font-weight: 500;
      margin-inline-start: 0.5rem;
    }

    .site-nav a {
      color: var(--header-fg);
      text-decoration: none;
      padding-block: 0.25rem;
      border-bottom: 2px solid transparent;
    }

    .site-nav a:hover,
    .site-nav a[aria-current] {
      border-bottom-color: var(--cpik-lazuli);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-inline-start: auto;
    }

    .action-button {
      display: inline-grid;
      place-items: center;
      min-width: 2.5rem;
      height: 2.5rem;
      padding-inline: 0.5rem;
      border: 1px solid var(--control-line);
      border-radius: 0.5rem;
      background: transparent;
      color: var(--header-fg);
      font: inherit;
      font-size: var(--fs-s);
      font-weight: 700;
      cursor: pointer;
    }

    .action-button:hover {
      background: var(--control-hover);
    }

    .theme-toggle .sun,
    [data-theme="light"] .theme-toggle .moon {
      display: none;
    }

    [data-theme="light"] .theme-toggle .sun {
      display: block;
    }

    .cta {
      display: inline-flex;
      align-items: center;
      height: 2.5rem;
      padding-inline: 1rem;
      border-radius: 0.5rem;
      background: var(--cpik-lazuli);
      color: var(--cpik-paper);
      font-size: var(--fs-s);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .cta:hover {
      color: var(--cpik-paper);
      background: #3B4DE0;
    }

    /* Hero */
    .hero {
      padding-block: var(--block) calc(var(--block) * 0.6);
    }

    .eyebrow {
      color: var(--muted);
      font-size: var(--fs-s);
      font-weight: 500;
    }

    .hero h1 {
      font-size: var(--fs-h1);
      margin-top: 0.35rem;
    }

    .hero p.lead {
      max-width: var(--measure);
      margin-top: 0.75rem;
      color: var(--muted);
    }

    /* Toolbar */
    .toolbar {
      position: sticky;
      top: 4.25rem;
      z-index: 5;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      padding-block: 0.75rem;
    }

    .toolbar .wrap {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
    }

    .search-field {
      position: relative;
      flex: 1 1 18rem;
    }

    .search-field .ui-icon {
      position: absolute;
      inset-inline-start: 0.85rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
    }

    input[type="search"] {
      width: 100%;
      height: 2.75rem;
      border: 1px solid var(--line);
      border-radius: 0.6rem;
      background: var(--surface);
      color: var(--fg);
      font: inherit;
      font-size: var(--fs-s);
    }

    input[type="search"] {
      padding-inline: 2.6rem 2.6rem;
    }

    input[type="search"]::-webkit-search-cancel-button {
      display: none;
    }

    input[type="search"]::placeholder {
      color: var(--muted);
    }

    input[type="search"]:hover {
      border-color: var(--keyline);
    }

    .search-clear {
      position: absolute;
      inset-inline-end: 0.4rem;
      top: 50%;
      transform: translateY(-50%);
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: 0;
      border-radius: 0.4rem;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
    }

    .search-clear:hover {
      color: var(--fg);
      background: var(--surface-hover);
    }

    .search-clear[hidden] {
      display: none;
    }

    /* Category picker: a button and a popup with a search box and a listbox (native option popups ignore the page font). */
    .picker {
      position: relative;
      flex: 0 0 auto;
      min-width: 12rem;
    }

    .picker-button {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      width: 100%;
      height: 2.75rem;
      padding-inline: 0.9rem 0.85rem;
      border: 1px solid var(--line);
      border-radius: 0.6rem;
      background: var(--surface);
      color: var(--fg);
      font: inherit;
      font-size: var(--fs-s);
      white-space: nowrap;
      cursor: pointer;
    }

    .picker-button:hover,
    .picker-button[aria-expanded="true"] {
      border-color: var(--keyline);
    }

    .picker-button .ui-icon {
      width: 1rem;
      height: 1rem;
      color: var(--muted);
      transition: transform 0.15s ease;
    }

    .picker-button[aria-expanded="true"] .ui-icon {
      transform: rotate(180deg);
    }

    .picker-popup {
      position: absolute;
      top: calc(100% + 0.4rem);
      inset-inline-start: 0;
      z-index: 6;
      width: max(100%, 17rem);
      max-width: calc(100vw - 2 * var(--gutter));
      padding: 0.4rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
      box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.3);
    }

    .picker-popup[hidden] {
      display: none;
    }

    .picker-popup .search-field input {
      height: 2.5rem;
      padding-inline: 2.5rem 0.75rem;
      background: var(--bg);
    }

    .picker-list {
      list-style: none;
      margin: 0.4rem 0 0;
      padding: 0;
      max-height: min(20rem, 50vh);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .picker-option {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.55rem 0.7rem;
      border-radius: 0.45rem;
      font-size: var(--fs-s);
      cursor: pointer;
    }

    .picker-option[hidden] {
      display: none;
    }

    .picker-option[data-active] {
      background: var(--control-hover);
    }

    .picker-option[aria-selected="true"] {
      color: var(--accent-text);
      font-weight: 500;
    }

    .picker-count {
      color: var(--muted);
      font-weight: 400;
    }

    .picker-empty {
      margin: 0;
      padding: 0.75rem 0.7rem;
      color: var(--muted);
      font-size: var(--fs-s);
    }

    .results {
      color: var(--muted);
      font-size: var(--fs-s);
      margin: 0;
      white-space: nowrap;
    }

    /* Gallery */
    .gallery-section {
      padding-block: var(--gap) var(--block);
    }

    .gallery {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
      gap: var(--gap);
    }

    .preview {
      position: relative;
      display: flex;
      flex-direction: column;
      min-width: 0;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      overflow: hidden;
      transition: border-color 0.15s;
    }

    .preview:hover {
      border-color: var(--keyline);
    }

    .preview[hidden] {
      display: none;
    }

    .preview .inner {
      display: grid;
      place-items: center;
      width: 100%;
      height: 7rem;
      padding: 0;
      border: 0;
      background: transparent;
      font-size: 3rem;
      color: var(--fg);
      cursor: pointer;
    }

    .preview .inner:hover {
      background: var(--surface-hover);
    }

    .badge-new {
      position: absolute;
      top: 0.55rem;
      inset-inline-start: 0.55rem;
      padding: 0.05rem 0.55rem;
      border-radius: 999px;
      background: var(--accent);
      color: var(--on-accent);
      font-size: 0.75rem;
      font-weight: 700;
      pointer-events: none;
    }

    .badge-new[hidden] {
      display: none;
    }

    /* "New" chip in the toolbar: the same filter as the dropdown's «تازه‌ها» option. */
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      height: 2.75rem;
      padding-inline: 0.9rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
      color: var(--fg);
      font: inherit;
      font-size: var(--fs-s);
      font-weight: 500;
      white-space: nowrap;
      cursor: pointer;
    }

    .chip:hover {
      border-color: var(--keyline);
    }

    .chip[aria-pressed="true"] {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }

    .chip[hidden] {
      display: none;
    }

    /* Request an icon: a notice box with a button. Two classes, so it wins over the .notice base rule further down. */
    .notice.request-box {
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: calc(var(--gap) * 1.5);
    }

    .notice.request-box .request-text {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      flex: 1 1 20rem;
    }

    .notice.request-box .ui-icon {
      margin-top: 0;
    }

    .request-button {
      display: inline-flex;
      align-items: center;
      height: 2.4rem;
      padding-inline: 1rem;
      border-radius: 0.5rem;
      background: var(--accent);
      color: var(--on-accent);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
    }

    .request-button:hover {
      color: var(--on-accent);
      background: #3B4DE0;
    }

    .request-link {
      font-weight: 700;
    }

    .empty .request-link {
      display: inline-block;
      margin-top: 0.5rem;
    }

    /* Icon detail panel */
    .detail {
      width: min(34rem, calc(100% - 2rem));
      max-height: calc(100% - 2rem);
      padding: 1.25rem;
      border: 1px solid var(--line);
      border-radius: 1rem;
      background: var(--bg);
      color: var(--fg);
    }

    .detail::backdrop {
      background: rgb(0 0 0 / 0.6);
    }

    .detail-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .detail-head h2 {
      font-size: var(--fs-h3);
    }

    .detail-close {
      color: var(--fg);
      border-color: var(--line);
    }

    .detail-close:hover {
      background: var(--surface-hover);
    }

    .detail-preview {
      display: grid;
      place-items: center;
      height: 11rem;
      margin-top: 1rem;
      border-radius: 0.75rem;
      background: var(--surface);
      border: 1px solid var(--line);
      overflow: hidden;
    }

    .detail-preview i::before {
      display: block;
    }

    .detail-controls {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.75rem 1rem;
      margin-top: 1rem;
      font-size: var(--fs-s);
    }

    .detail-controls output {
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }

    .detail-controls input[type="range"] {
      width: 100%;
      accent-color: var(--accent);
    }

    .detail-controls input[type="color"] {
      width: 2.75rem;
      height: 2rem;
      padding: 0.15rem;
      border: 1px solid var(--line);
      border-radius: 0.4rem;
      background: var(--surface);
      cursor: pointer;
    }

    /* Preset colours next to the native picker: the picker opens on the near-white text colour,
       where moving the hue barely changes anything. */
    .color-choices {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      min-width: 0;
    }

    .swatches {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
    }

    .swatch {
      width: 1.5rem;
      height: 1.5rem;
      padding: 0;
      border: 2px solid var(--surface);
      border-radius: 50%;
      background: var(--swatch);
      box-shadow: 0 0 0 1px var(--line);
      cursor: pointer;
    }

    .swatch:hover {
      box-shadow: 0 0 0 1px var(--keyline);
    }

    .swatch[aria-pressed="true"] {
      box-shadow: 0 0 0 2px var(--fg);
    }

    @media (max-width: 560px) {
      .color-choices {
        grid-column: 2 / -1;
      }

      #detail-color-reset {
        grid-column: 2 / -1;
        justify-self: start;
      }
    }

    .detail-info {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.4rem 1rem;
      margin: 1rem 0 0;
      font-size: var(--fs-s);
    }

    .detail-info dt {
      color: var(--muted);
    }

    .detail-info dd {
      margin: 0;
      overflow-wrap: anywhere;
    }

    /* Latin values (name, class, codepoint, version) keep their own order but line up with the Persian ones. */
    [dir="rtl"] .detail-info dd[dir="ltr"] {
      text-align: right;
    }

    .detail-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.1rem;
    }

    .text-button {
      height: 2.4rem;
      padding-inline: 0.9rem;
      border: 1px solid var(--line);
      border-radius: 0.5rem;
      background: var(--surface);
      color: var(--fg);
      font: inherit;
      font-size: var(--fs-s);
      font-weight: 500;
      cursor: pointer;
    }

    .text-button:hover {
      border-color: var(--keyline);
    }

    .text-button[data-state="copied"] {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }

    .text-button[data-state="error"] {
      border-color: #E5484D;
      color: #E5484D;
    }

    .caption {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      min-width: 0;
      gap: 0.15rem;
      padding: 0.6rem 0.75rem 0.7rem;
      border-top: 1px solid var(--line);
    }

    .card-bottom {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .brand-name {
      flex: 1 1 auto;
      min-width: 0;
      font-weight: 700;
      font-size: var(--fs-s);
      line-height: 1.5;
      /* Long names wrap to two lines; every card reserves both so the rows stay even. */
      min-height: 3em;
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      overflow: hidden;
    }

    .class-name {
      display: block;
      color: var(--muted);
      font-size: 0.75rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-align: left;
    }

    [dir="rtl"] .class-name,
    [dir="rtl"] .brand-name {
      text-align: right;
    }

    .copy-button {
      position: relative;
      display: grid;
      place-items: center;
      flex: none;
      width: 2.1rem;
      height: 2.1rem;
      border: 1px solid var(--line);
      border-radius: 0.45rem;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
    }

    .copy-button:hover {
      color: var(--fg);
      border-color: var(--keyline);
    }

    .copy-button .copy-check,
    .copy-button[data-state="copied"] .copy-symbol {
      display: none;
    }

    .copy-button[data-state="copied"] {
      color: var(--on-accent);
      background: var(--accent);
      border-color: var(--accent);
    }

    .copy-button[data-state="copied"] .copy-check {
      display: block;
    }

    .copy-button[data-state="error"] {
      border-color: #E5484D;
      color: #E5484D;
    }

    .copy-button[aria-disabled="true"] {
      cursor: progress;
    }

    .empty {
      padding: var(--block) 0;
      color: var(--muted);
      text-align: center;
    }

    /* Guide */
    /* The guide cards, the two notices and the footer line share one gap (--gap). */
    .guide {
      padding-block: var(--block) var(--gap);
      border-top: 1px solid var(--line);
    }

    .guide h2 {
      font-size: var(--fs-h2);
    }

    .guide > .wrap > p:not(.notice) {
      max-width: var(--measure);
      margin-top: 0.5rem;
      color: var(--muted);
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      gap: var(--gap);
      margin-top: calc(var(--gap) * 1.5);
    }

    .guide-step {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      min-width: 0;
      padding: 1.1rem 1.25rem 1.25rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
    }

    .guide-step h3 {
      font-size: var(--fs-h3);
    }

    .guide-step h3 .num {
      color: var(--accent-text);
      margin-inline-end: 0.35rem;
    }

    .guide-step p {
      color: var(--muted);
      font-size: var(--fs-s);
    }

    .code-block {
      position: relative;
      margin-top: auto;
    }

    .code-block pre {
      overflow-x: auto;
      padding: 0.9rem 3.25rem 0.9rem 1rem;
      border-radius: 0.6rem;
      background: var(--code-bg);
      color: var(--code-fg);
      border: 1px solid var(--code-line);
      font-size: 0.8125rem;
      line-height: 1.7;
      text-align: left;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .code-block .copy-button {
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      color: var(--code-muted);
      border-color: var(--code-line);
      background: var(--code-bg);
    }

    .code-block .copy-button:hover {
      color: var(--code-fg);
    }

    .guide-preview {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      margin-top: auto;
      padding: 1rem;
      border-radius: 0.6rem;
      border: 1px dashed var(--keyline);
    }

    /* A block glyph box drops the text baseline offset, so the icon sits in the exact middle. */
    .preview .inner i::before,
    .guide-preview i::before {
      display: block;
    }

    .guide-preview i:nth-child(1) {
      font-size: 16px;
    }

    .guide-preview i:nth-child(2) {
      font-size: 32px;
    }

    .guide-preview i:nth-child(3) {
      font-size: 64px;
      color: var(--accent-text);
    }

    /* Notice: a boxed note with an icon, used for the guide note and the licence. */
    .notice {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.9rem 1.1rem;
      background: var(--surface);
      border: 1px solid var(--line);
      border-inline-start: 3px solid var(--accent);
      border-radius: 0.6rem;
      color: var(--muted);
      font-size: var(--fs-s);
      line-height: 1.75;
    }

    .notice .ui-icon {
      margin-top: 0.2rem;
      color: var(--accent-text);
    }

    .guide .notice {
      margin-top: var(--gap);
    }

    .licence {
      padding-bottom: var(--gap);
    }

    /* Footer */
    .site-footer {
      border-top: 1px solid var(--line);
      padding-block: 1.5rem 2rem;
      color: var(--muted);
      font-size: var(--fs-s);
    }

    .site-footer .wrap {
      text-align: center;
    }

    .site-footer p {
      margin: 0;
    }

    /* The version sits on its own line under the copyright. */
    .footer-version {
      display: block;
      margin-top: 0.2rem;
    }

    .back-to-top {
      position: fixed;
      inset-inline-end: 1rem;
      bottom: 1rem;
      z-index: 20;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      border-radius: 50%;
      background: var(--accent);
      color: var(--on-accent);
      cursor: pointer;
      box-shadow: 0 4px 16px rgb(0 0 0 / 0.25);
    }

    .back-to-top[hidden] {
      display: none;
    }

    @media (max-width: 40rem) {
      .site-footer {
        padding-bottom: 5rem;
      }

      .brand .brand-lockup {
        display: none;
      }

      .brand .brand-symbol {
        display: block;
      }

      .site-nav {
        order: 3;
        width: 100%;
        margin-inline-start: 0;
      }

      .header-actions {
        margin-inline-start: auto;
      }

      .toolbar {
        position: static;
      }

      .picker {
        flex: 1 1 auto;
      }

      .gallery {
        grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
      }

      .cta {
        padding-inline: 0.75rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      .preview {
        transition: none;
      }
    }
  </style>
</head>

<body>
  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="#icons" aria-label="CPIK">
        <svg class="brand-symbol" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M7 2H17A5 5 0 0 1 22 7H20A3 3 0 0 0 17 4H7A3 3 0 0 0 4 7V17A3 3 0 0 0 7 20H17A3 3 0 0 0 20 17H22A5 5 0 0 1 17 22H7A5 5 0 0 1 2 17V7A5 5 0 0 1 7 2Z" />
          <path class="tile" d="M12 8H16A2 2 0 0 1 18 10V14A2 2 0 0 1 16 16H12A2 2 0 0 1 10 14V10A2 2 0 0 1 12 8Z" />
        </svg>
        <svg class="brand-lockup" viewBox="0 0 100 24" width="133" height="32" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M7 2H17A5 5 0 0 1 22 7H20A3 3 0 0 0 17 4H7A3 3 0 0 0 4 7V17A3 3 0 0 0 7 20H17A3 3 0 0 0 20 17H22A5 5 0 0 1 17 22H7A5 5 0 0 1 2 17V7A5 5 0 0 1 7 2Z" />
          <path class="tile" d="M12 8H16A2 2 0 0 1 18 10V14A2 2 0 0 1 16 16H12A2 2 0 0 1 10 14V10A2 2 0 0 1 12 8Z" />
          <path transform="translate(32 0)" fill="currentColor" d="M6 2H12A6 6 0 0 1 18 8H14A2 2 0 0 0 12 6H6A2 2 0 0 0 4 8V16A2 2 0 0 0 6 18H12A2 2 0 0 0 14 16H18A6 6 0 0 1 12 22H6A6 6 0 0 1 0 16V8A6 6 0 0 1 6 2Z" />
          <path transform="translate(54 0)" fill="currentColor" fill-rule="evenodd" d="M0 2H10A6 6 0 0 1 10 14H4V22H0Z M4 6V10H10A2 2 0 0 0 10 6Z" />
          <path transform="translate(75 0)" fill="currentColor" d="M0 2H4V22H0Z" />
          <path transform="translate(84 0)" fill="currentColor" d="M0 2H4V22H0Z M10 2H16L4 14V8Z M4 10L16 22H10L4 16Z" />
        </svg>
      </a>

      <nav class="site-nav" aria-label="CPIK">
        <a href="#icons" aria-current="location" data-i18n="navIcons">آیکون‌ها</a>
        <a href="#guide" data-i18n="navGuide">راهنما</a>
      </nav>

      <div class="header-actions">

        <button id="theme-toggle" class="action-button theme-toggle" type="button">
          <svg class="ui-icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20.9 13.1A9 9 0 0 1 10.9 3.1 9 9 0 1 0 20.9 13.1Z" />
          </svg>
          <svg class="ui-icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
          </svg>
        </button>

        <a class="cta" href="https://github.com/cyclone9/CPIK/releases/latest" data-i18n="download">دریافت کیت</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow"><bdi dir="ltr">CPIK</bdi> · <span data-i18n="shortName">کیت آیکون</span> <bdi dir="ltr" data-version-output></bdi></p>
        <h1 data-i18n="tagline">برندهای ایرانی، در یک کیت آیکون.</h1>
        <p class="lead" data-i18n="description">کیت CPIK آیکون بانک‌ها، پلتفرم‌ها، سرویس‌ها و برندهای ایرانی را یک‌جا می‌دهد. یک فایل استایل را لینک کنید تا هر آیکون با یک نام کلاس در دسترس باشد؛ در هر اندازه‌ای واضح می‌ماند و مثل متن کنارش با CSS رنگ می‌گیرد. لوگوها متعلق به صاحبانشان است.</p>
      </div>
    </section>

    <div class="toolbar">
      <div class="wrap">
        <div class="search-field">
          <label class="sr-only" for="icon-search" data-i18n="searchLabel">جستجوی آیکون</label>
          <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
          <input id="icon-search" type="search" data-i18n-placeholder="searchPlaceholder"
            placeholder="جستجو با نام یا کلیدواژه" autocomplete="off" spellcheck="false" aria-controls="icon-gallery">
          <button id="search-clear" class="search-clear" type="button" aria-controls="icon-gallery" hidden>
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m6 6 12 12M6 18 18 6" />
            </svg>
          </button>
        </div>

        <div id="category-picker" class="picker">
          <span id="picker-label" class="sr-only" data-i18n="filterLabel">دسته</span>
          <button id="picker-button" class="picker-button" type="button" aria-haspopup="listbox" aria-expanded="false"
            aria-controls="picker-popup" aria-labelledby="picker-label picker-value">
            <span id="picker-value"></span>
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </button>
          <div id="picker-popup" class="picker-popup" hidden>
            <div class="search-field">
              <label class="sr-only" for="picker-search" data-i18n="categorySearch">جستجوی دسته</label>
              <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <input id="picker-search" type="search" role="combobox" aria-autocomplete="list" aria-expanded="true"
                aria-controls="picker-list" data-i18n-placeholder="categorySearch" placeholder="جستجوی دسته"
                autocomplete="off" spellcheck="false">
            </div>
            <ul id="picker-list" class="picker-list" role="listbox" aria-labelledby="picker-label"></ul>
            <p class="picker-empty" data-i18n="categoryEmpty" hidden>دسته‌ای پیدا نشد.</p>
          </div>
        </div>
        <button id="new-toggle" class="chip" type="button" aria-pressed="false" aria-controls="icon-gallery" hidden></button>

        <p id="search-results" class="results" role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    </div>

    <section id="icons" class="gallery-section" aria-labelledby="icons-title">
      <h2 id="icons-title" class="sr-only" data-i18n="navIcons">آیکون‌ها</h2>
      <div class="wrap">
        <div id="icon-gallery" class="gallery">
          {{#each assets}}
          <div class="preview" data-name="{{ @key }}">
            <button class="inner" type="button"><i class="{{ ../prefix }}-{{ @key }}" aria-hidden="true"></i></button>
            <span class="badge-new" data-i18n="newBadge" hidden>تازه</span>
            <div class="caption">
              <div class="card-bottom">
                <bdi class="brand-name" dir="auto">{{ @key }}</bdi>
                <button class="copy-button" type="button" data-state="idle">
                  <svg class="ui-icon copy-symbol" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <rect x="9" y="9" width="12" height="12" rx="2" />
                    <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
                  </svg>
                  <svg class="ui-icon copy-check" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="m5 12 4 4L19 6" />
                  </svg>
                </button>
              </div>
              <code class="class-name" title="{{ ../prefix }}-{{ @key }}">{{ ../prefix }}-{{ @key }}</code>
              <span class="copy-feedback sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
            </div>
          </div>
          {{/each}}
        </div>

        <div id="empty-message" class="empty" hidden>
          <p data-i18n="empty">آیکونی پیدا نشد.</p>
          <a id="request-empty" class="request-link" target="_blank" rel="noopener" data-i18n="requestThis"
            href="https://github.com/cyclone9/CPIK/issues/new?template=icon-request.yml">درخواست این آیکون</a>
        </div>

        <div class="notice request-box">
          <span class="request-text">
            <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 5v14M5 12h14" />
            </svg>
            <span data-i18n="requestText">آیکونی که می‌خواهید در کیت نیست؟ برند، بانک یا سرویس آن را از طریق GitHub درخواست کنید.</span>
          </span>
          <a id="request-link" class="request-button" target="_blank" rel="noopener" data-i18n="requestLink"
            href="https://github.com/cyclone9/CPIK/issues/new?template=icon-request.yml">درخواست آیکون</a>
        </div>
      </div>
    </section>

    <section id="guide" class="guide" aria-labelledby="guide-title">
      <div class="wrap">
        <h2 id="guide-title" data-i18n="guideTitle">راهنمای استفاده</h2>
        <p data-i18n="guideIntro">فایل استایل را اضافه کنید، آیکون را انتخاب کنید و کد HTML آن را در صفحه بگذارید.</p>

        <div class="steps">
          <div class="guide-step">
            <h3><span class="num">۱</span><span data-i18n="guideFilesTitle">افزودن استایل</span></h3>
            <p data-i18n="guideFilesText">فایل cpik.css و فونت‌های WOFF و WOFF2 آن را کنار هم در پوشه‌ی assets/cpik بگذارید و این خط را در head صفحه اضافه کنید.</p>
            <pre><code>&lt;link rel="stylesheet" href="./assets/cpik/cpik.css"&gt;</code></pre>
            <p data-i18n="guideCdnText">یا بدون کپی فایل‌ها، آن را از jsDelivr بارگذاری کنید:</p>
            <pre><code data-cdn-link>&lt;link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@cyclone9/cpik/dist/cpik.css"&gt;</code></pre>
          </div>

          <div class="guide-step">
            <h3><span class="num">۲</span><span data-i18n="guideIconTitle">افزودن آیکون</span></h3>
            <p data-i18n="guideIconText">هر آیکون فقط یک کلاس دارد. دکمه‌ی کپی هر کارت را بزنید و کد را هر جا خواستید بگذارید.</p>
            <pre><code>&lt;i class="cpik-cyclone-cpik" aria-hidden="true"&gt;&lt;/i&gt;</code></pre>
          </div>

          <div class="guide-step">
            <h3><span class="num">۳</span><span data-i18n="guideStyleTitle">اندازه و رنگ</span></h3>
            <p data-i18n="guideStyleText">آیکون مثل متن است: اندازه را با font-size و رنگ را با color تنظیم کنید.</p>
            <pre><code>.cpik-cyclone-cpik {
  font-size: 48px;
  color: #4A5CF0;
}</code></pre>
          </div>

          <div class="guide-step">
            <h3><span class="num">۴</span><span data-i18n="guidePreviewTitle">پیش‌نمایش</span></h3>
            <p data-i18n="guidePreviewText">همان آیکون در ۱۶، ۳۲ و ۶۴ پیکسل.</p>
            <div class="guide-preview" dir="ltr">
              <i class="cpik-cyclone-cpik" aria-hidden="true"></i>
              <i class="cpik-cyclone-cpik" aria-hidden="true"></i>
              <i class="cpik-cyclone-cpik" aria-hidden="true"></i>
            </div>
          </div>
        </div>

        <p class="notice">
          <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5M12 8h.01" />
          </svg>
          <span data-i18n="guideNote">فایل cpik.js فقط برای همین صفحه است و آیکون‌ها به JavaScript نیاز ندارند. اگر دکمه‌ای فقط آیکون دارد، به خود دکمه یک نام دسترس‌پذیر مثل aria-label بدهید.</span>
        </p>
      </div>
    </section>

    <section class="licence" aria-label="MIT">
      <div class="wrap">
        <p class="notice">
          <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z" />
            <path d="m9 12 2 2 4-4" />
          </svg>
          <span data-i18n="licence">کیت با مجوز MIT منتشر شده است. لوگوها متعلق به صاحبانشان است و استفاده از آن‌ها به معنای همکاری با آن برندها نیست.</span>
        </p>
      </div>
    </section>
  </main>

  <dialog id="icon-dialog" class="detail" aria-labelledby="detail-title">
    <div class="detail-head">
      <h2 id="detail-title"></h2>
      <button id="detail-close" class="action-button detail-close" type="button">
        <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="m6 6 12 12M6 18 18 6" />
        </svg>
      </button>
    </div>

    <div class="detail-preview">
      <i id="detail-icon" aria-hidden="true"></i>
    </div>

    <div class="detail-controls">
      <label for="detail-size" data-i18n="size">اندازه</label>
      <input id="detail-size" type="range" min="16" max="128" step="4" value="64">
      <output id="detail-size-out" for="detail-size" dir="ltr">64px</output>

      <label for="detail-color" data-i18n="color">رنگ</label>
      <div class="color-choices">
        <div class="swatches" role="group" aria-label="رنگ‌های آماده">
          <button class="swatch" type="button" data-color="#4A5CF0" style="--swatch: #4A5CF0" aria-label="لاجوردی" aria-pressed="false"></button>
          <button class="swatch" type="button" data-color="#E5484D" style="--swatch: #E5484D" aria-label="قرمز" aria-pressed="false"></button>
          <button class="swatch" type="button" data-color="#F76B15" style="--swatch: #F76B15" aria-label="نارنجی" aria-pressed="false"></button>
          <button class="swatch" type="button" data-color="#FFC53D" style="--swatch: #FFC53D" aria-label="زرد" aria-pressed="false"></button>
          <button class="swatch" type="button" data-color="#30A46C" style="--swatch: #30A46C" aria-label="سبز" aria-pressed="false"></button>
          <button class="swatch" type="button" data-color="#12A594" style="--swatch: #12A594" aria-label="فیروزه‌ای" aria-pressed="false"></button>
          <button class="swatch" type="button" data-color="#D6409F" style="--swatch: #D6409F" aria-label="صورتی" aria-pressed="false"></button>
          <button class="swatch" type="button" data-color="#8E4EC6" style="--swatch: #8E4EC6" aria-label="بنفش" aria-pressed="false"></button>
        </div>
        <input id="detail-color" type="color" value="#F4F2EC">
      </div>
      <button id="detail-color-reset" class="text-button" type="button" data-i18n="resetColor">رنگ پیش‌فرض</button>
    </div>

    <dl class="detail-info">
      <dt data-i18n="englishName">نام انگلیسی</dt>
      <dd id="detail-en" dir="ltr"></dd>
      <dt data-i18n="className">کلاس</dt>
      <dd dir="ltr"><code id="detail-class"></code></dd>
      <dt data-i18n="codepoint">کدپوینت</dt>
      <dd dir="ltr"><code id="detail-codepoint"></code></dd>
      <dt data-i18n="category">دسته</dt>
      <dd id="detail-category"></dd>
      <dt data-i18n="addedIn">افزوده در نسخه</dt>
      <dd id="detail-added" dir="ltr"></dd>
    </dl>

    <div class="detail-actions">
      <button class="text-button" type="button" data-copy="html">کپی HTML</button>
      <button class="text-button" type="button" data-copy="class">کپی کلاس</button>
      <button class="text-button" type="button" data-copy="codepoint">کپی کدپوینت</button>
    </div>
    <span id="detail-feedback" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
  </dialog>

  <footer id="site-footer" class="site-footer">
    <div class="wrap">
      <p lang="en" dir="ltr">
        &copy; <span id="copyright-years">2026</span>
        <a href="https://cyclone9.ir/cpik">CyClone</a>
        · <bdi dir="ltr">CPIK - CyClone Power Icon Kit</bdi>
        <span class="footer-version" data-version-output></span>
      </p>
    </div>
  </footer>

  <button id="back-to-top" class="back-to-top" type="button" hidden>
    <svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M12 19V5m-6 6 6-6 6 6" />
    </svg>
  </button>

  <script src="./cpik.js"></script>

  <script>
    const root = document.documentElement;
    const searchInput = document.getElementById('icon-search');
    const searchClear = document.getElementById('search-clear');
    const categoryFilter = createCategoryPicker(document.getElementById('category-picker'));
    const results = document.getElementById('search-results');
    const emptyMessage = document.getElementById('empty-message');
    const themeToggle = document.getElementById('theme-toggle');
    const backToTop = document.getElementById('back-to-top');
    const metadata = window.CPIK_DATA || {};
    const categories = window.CPIK_CATEGORIES || [];
    const version = window.CPIK_VERSION;
    // The page is Persian only; names and labels come from the fa entries.
    const language = 'fa';

    const translations = {
      fa: {
        navIcons: 'آیکون‌ها',
        navGuide: 'راهنما',
        download: 'دریافت کیت',
        shortName: 'کیت آیکون',
        tagline: 'برندهای ایرانی، در یک کیت آیکون.',
        description: 'کیت CPIK آیکون بانک‌ها، پلتفرم‌ها، سرویس‌ها و برندهای ایرانی را یک‌جا می‌دهد. یک فایل استایل را لینک کنید تا هر آیکون با یک نام کلاس در دسترس باشد؛ در هر اندازه‌ای واضح می‌ماند و مثل متن کنارش با CSS رنگ می‌گیرد. لوگوها متعلق به صاحبانشان است.',
        searchLabel: 'جستجوی آیکون',
        searchPlaceholder: 'جستجو با نام یا کلیدواژه',
        filterLabel: 'دسته',
        categorySearch: 'جستجوی دسته',
        categoryEmpty: 'دسته‌ای پیدا نشد.',
        all: 'همه‌ی آیکون‌ها',
        other: 'سایر',
        empty: 'آیکونی پیدا نشد. نام، کلیدواژه یا دسته‌ی دیگری را امتحان کنید.',
        guideTitle: 'راهنمای استفاده',
        guideIntro: 'فایل استایل را اضافه کنید، آیکون را انتخاب کنید و کد HTML آن را در صفحه بگذارید.',
        guideFilesTitle: 'افزودن استایل',
        guideFilesText: 'فایل cpik.css و فونت‌های WOFF و WOFF2 آن را کنار هم در پوشه‌ی assets/cpik بگذارید و این خط را در head صفحه اضافه کنید.',
        guideCdnText: 'یا بدون کپی فایل‌ها، آن را از jsDelivr بارگذاری کنید:',
        guideIconTitle: 'افزودن آیکون',
        guideIconText: 'هر آیکون فقط یک کلاس دارد. دکمه‌ی کپی هر کارت را بزنید و کد را هر جا خواستید بگذارید.',
        guideStyleTitle: 'اندازه و رنگ',
        guideStyleText: 'آیکون مثل متن است: اندازه را با font-size و رنگ را با color تنظیم کنید.',
        guidePreviewTitle: 'پیش‌نمایش',
        guidePreviewText: 'همان آیکون در ۱۶، ۳۲ و ۶۴ پیکسل.',
        guideNote: 'فایل cpik.js فقط برای همین صفحه است و آیکون‌ها به JavaScript نیاز ندارند. اگر دکمه‌ای فقط آیکون دارد، به خود دکمه یک نام دسترس‌پذیر مثل aria-label بدهید.',
        licence: 'کیت با مجوز MIT منتشر شده است. لوگوها متعلق به صاحبانشان است و استفاده از آن‌ها به معنای همکاری با آن برندها نیست.',
        darkMode: 'تغییر به تم تیره',
        lightMode: 'تغییر به تم روشن',
        clearSearch: 'پاک کردن جستجو',
        backToTop: 'برگشت به بالا',
        copy: 'کپی کد HTML',
        copying: 'در حال کپی کد',
        copied: 'کد HTML کپی شد',
        copyFailed: 'کپی انجام نشد. دوباره امتحان کنید یا دسترسی کلیپ‌بورد را بررسی کنید.',
        copyCode: 'کپی کد',
        codeCopied: 'کد کپی شد',
        results: (visible, total) => `${visible} از ${total} آیکون`,
        newBadge: 'تازه',
        newFilter: 'تازه‌ها',
        requestText: 'آیکونی که می‌خواهید در کیت نیست؟ برند، بانک یا سرویس آن را از طریق GitHub درخواست کنید.',
        requestLink: 'درخواست آیکون',
        requestThis: 'درخواست این آیکون',
        requestTitle: 'درخواست آیکون',
        details: 'جزئیات',
        close: 'بستن',
        size: 'اندازه',
        color: 'رنگ',
        resetColor: 'رنگ پیش‌فرض',
        englishName: 'نام انگلیسی',
        className: 'کلاس',
        codepoint: 'کدپوینت',
        category: 'دسته',
        addedIn: 'افزوده در نسخه',
        copyHtml: 'کپی HTML',
        copyClass: 'کپی کلاس',
        copyCodepoint: 'کپی کدپوینت',
        copiedShort: 'کپی شد',
        copyError: 'کپی نشد'
      }
    };

    const dictionary = () => translations[language];
    const digits = value => new Intl.NumberFormat('fa-IR').format(value);

    document.querySelectorAll('[data-version-output]').forEach(element => {
      element.textContent = version ? `v${version}` : '';
    });

    /* The CDN example pins the version this page was built from. */
    document.querySelectorAll('[data-cdn-link]').forEach(element => {
      element.textContent = `<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@cyclone9/cpik${
        version ? `@${version}` : ''}/dist/cpik.css">`;
    });

    const startYear = 2026;
    const currentYear = new Date().getFullYear();

    document.getElementById('copyright-years').textContent =
      currentYear > startYear ? `${startYear}-${currentYear}` : String(startYear);

    function savePreference(key, value) {
      try {
        localStorage.setItem(key, value);
      } catch { }
    }

    /*
     * Search text: one form for Arabic and Persian letters and digits,
     * no diacritics or tatweel, and hyphens, underscores and zero-width
     * joiners read as spaces.
     */
    function normalize(value) {
      return String(value)
        .normalize('NFKC')
        .toLowerCase()
        .replace(/[يى]/g, 'ی')
        .replace(/ك/g, 'ک')
        .replace(/[آأإ]/g, 'ا')
        .replace(/[۰-۹]/g, digit => String(digit.charCodeAt(0) - 1776))
        .replace(/[٠-٩]/g, digit => String(digit.charCodeAt(0) - 1632))
        .replace(/[ً-ٰٟـ]/g, '')
        .replace(/[‌‍‎‏]/g, ' ')
        .replace(/[-_]+/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    const prefixes = new Set(categories.map(category => category.prefix));

    function getCategory(name) {
      const prefix = name.split('-')[0];

      return prefixes.has(prefix) ? prefix : 'other';
    }

    const icons = Array.from(
      document.querySelectorAll('#icon-gallery .preview'),
      element => {
        const key = element.dataset.name;
        const entry = Object.hasOwn(metadata, key) ? metadata[key] || {} : {};
        const names = {
          fa: typeof entry.name?.fa === 'string' ? entry.name.fa : key,
          en: typeof entry.name?.en === 'string' ? entry.name.en : key
        };
        const keywords = Array.isArray(entry.keywords) ?
          entry.keywords.filter(value => typeof value === 'string') : [];
        const iconClass = element.querySelector('.inner > i').className;
        const isNew = entry.isNew === true;

        element.querySelector('.badge-new').hidden = !isNew;

        return {
          element,
          key,
          names,
          iconClass,
          isNew,
          codepoint: typeof entry.codepoint === 'string' ? entry.codepoint : '',
          added: typeof entry.added === 'string' ? entry.added : '',
          openButton: element.querySelector('.inner'),
          nameElement: element.querySelector('.brand-name'),
          copyButton: element.querySelector('.copy-button'),
          feedback: element.querySelector('.copy-feedback'),
          html: `<i class="${iconClass}" aria-hidden="true"></i>`,
          category: getCategory(key),
          searchText: normalize([key, names.fa, names.en, ...keywords].join(' ')),
          state: 'idle',
          busy: false,
          resetTimer: null
        };
      }
    );

    /* Gallery order: categories as listed in config/categories.json, then by Persian name,
       ignoring a leading «بانک» or «موسسه اعتباری» so banks don't all sort under ب.
       TV channels go by number instead (channel-1, channel-2, ...). */
    const categoryOrder = [...categories.map(category => category.prefix), 'other'];
    const persianOrder = new Intl.Collator('fa');
    const numericOrder = new Intl.Collator('en', { numeric: true });
    const sortName = icon => icon.names.fa.replace(/^(بانک|مؤسسه اعتباری|موسسه اعتباری)\s+/, '');

    icons.sort((a, b) =>
      categoryOrder.indexOf(a.category) - categoryOrder.indexOf(b.category) ||
      (a.category === 'channel' ? numericOrder.compare(a.key, b.key) : 0) ||
      persianOrder.compare(sortName(a), sortName(b)) ||
      a.key.localeCompare(b.key));
    document.getElementById('icon-gallery').append(...icons.map(icon => icon.element));

    const usedCategories = new Set(icons.map(icon => icon.category));

    /*
     * Category picker. It exposes the parts of a <select> the page uses (value,
     * change event), so the filter code treats it as one. Focus stays in the
     * search box while the popup is open; aria-activedescendant marks the option.
     */
    function createCategoryPicker(element) {
      const button = element.querySelector('.picker-button');
      const buttonText = element.querySelector('#picker-value');
      const popup = element.querySelector('.picker-popup');
      const search = popup.querySelector('input');
      const list = popup.querySelector('[role="listbox"]');
      const empty = popup.querySelector('.picker-empty');
      let items = [];
      let current = 'all';
      let active = null;

      const itemFor = value => items.find(item => item.value === value);
      const visibleItems = () => items.filter(item => !item.element.hidden);

      function updateSelection() {
        const item = itemFor(current);

        buttonText.textContent = item ? `${item.label} (${item.count})` : '';

        for (const { value, element: option } of items) {
          option.setAttribute('aria-selected', String(value === current));
        }
      }

      function setActive(item, scroll = true) {
        active?.element.removeAttribute('data-active');
        active = item;

        if (item) {
          item.element.dataset.active = '';
          search.setAttribute('aria-activedescendant', item.element.id);

          if (scroll) {
            item.element.scrollIntoView({ block: 'nearest' });
          }
        } else {
          search.removeAttribute('aria-activedescendant');
        }
      }

      function filterList() {
        const query = normalize(search.value);
        const terms = query ? query.split(' ') : [];

        for (const item of items) {
          item.element.hidden = !terms.every(term => item.searchText.includes(term));
        }

        const visible = visibleItems();

        empty.hidden = visible.length > 0;
        setActive(visible[0] ?? null);
      }

      function open(query = '') {
        if (!popup.hidden) {
          return;
        }

        popup.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        search.value = query;
        filterList();

        if (!query) {
          setActive(itemFor(current) ?? null);
        }

        search.focus({ preventScroll: true });
      }

      function close(returnFocus) {
        if (popup.hidden) {
          return;
        }

        popup.hidden = true;
        button.setAttribute('aria-expanded', 'false');
        setActive(null);

        if (returnFocus) {
          button.focus({ preventScroll: true });
        }
      }

      function choose(item) {
        close(true);

        if (item && item.value !== current) {
          current = item.value;
          updateSelection();
          element.dispatchEvent(new Event('change'));
        }
      }

      function move(step) {
        const visible = visibleItems();
        const index = visible.indexOf(active);

        if (visible.length) {
          setActive(visible[Math.min(Math.max(index + step, 0), visible.length - 1)]);
        }
      }

      button.addEventListener('click', () => {
        if (popup.hidden) {
          open();
        } else {
          close(true);
        }
      });

      button.addEventListener('keydown', event => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          open();
        } else if (event.key.length === 1 && event.key !== ' ' &&
            !event.ctrlKey && !event.metaKey && !event.altKey) {
          // Typing on the closed button starts a search with that letter.
          event.preventDefault();
          open(event.key);
        }
      });

      search.addEventListener('input', filterList);
      search.addEventListener('keydown', event => {
        if (event.isComposing) {
          return;
        }

        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          move(event.key === 'ArrowDown' ? 1 : -1);
        } else if (event.key === 'Enter') {
          event.preventDefault();

          if (active) {
            choose(active);
          }
        } else if (event.key === 'Escape') {
          event.preventDefault();
          close(true);
        }
      });

      // Keep focus in the search box when an option is pressed.
      list.addEventListener('mousedown', event => event.preventDefault());
      list.addEventListener('click', event => {
        const option = event.target.closest('[role="option"]');

        if (option) {
          choose(items.find(item => item.element === option));
        }
      });
      list.addEventListener('mousemove', event => {
        const option = event.target.closest('[role="option"]');

        if (option && option !== active?.element) {
          setActive(items.find(item => item.element === option), false);
        }
      });

      element.addEventListener('focusout', event => {
        if (event.relatedTarget && !element.contains(event.relatedTarget)) {
          close(false);
        }
      });
      document.addEventListener('pointerdown', event => {
        if (!element.contains(event.target)) {
          close(false);
        }
      });

      return {
        get value() {
          return current;
        },
        set value(value) {
          current = value;
          updateSelection();
        },
        setOptions(options) {
          items = options.map(({ value, label, count, keywords }) => {
            const option = document.createElement('li');
            const name = document.createElement('span');
            const amount = document.createElement('span');

            option.id = `picker-option-${value}`;
            option.className = 'picker-option';
            option.setAttribute('role', 'option');
            name.textContent = label;
            amount.className = 'picker-count';
            amount.textContent = count;
            option.append(name, amount);

            return { value, label, count, searchText: normalize(`${label} ${keywords}`), element: option };
          });
          list.replaceChildren(...items.map(item => item.element));
          updateSelection();

          if (!popup.hidden) {
            filterList();
          }
        },
        addEventListener: (type, listener) => element.addEventListener(type, listener)
      };
    }

    function renderCategories() {
      const selected = categoryFilter.value || 'all';
      const options = [{ value: 'all', label: dictionary().all, keywords: 'all' }];

      if (icons.some(icon => icon.isNew)) {
        options.push({ value: 'new', label: dictionary().newFilter, keywords: 'new' });
      }

      for (const category of categories) {
        if (usedCategories.has(category.prefix)) {
          options.push({
            value: category.prefix,
            label: category[language],
            keywords: `${category.en} ${category.prefix}`
          });
        }
      }

      if (usedCategories.has('other')) {
        options.push({ value: 'other', label: dictionary().other, keywords: 'other' });
      }

      categoryFilter.setOptions(options.map(option => ({
        ...option,
        count: digits(option.value === 'all' ? icons.length :
          icons.filter(icon => inCategory(icon, option.value)).length)
      })));
      categoryFilter.value = options.some(option => option.value === selected) ?
        selected : 'all';
    }

    function updateCopyButton(icon) {
      const label = dictionary()[{
        idle: 'copy',
        busy: 'copying',
        copied: 'copied',
        error: 'copyFailed'
      }[icon.state]];

      icon.copyButton.dataset.state = icon.state;
      icon.copyButton.title = label;
      icon.copyButton.setAttribute('aria-label', `${label}: ${icon.names[language]}`);

      if (icon.busy) {
        icon.copyButton.setAttribute('aria-disabled', 'true');
      } else {
        icon.copyButton.removeAttribute('aria-disabled');
      }

      icon.feedback.textContent = icon.state === 'copied' || icon.state === 'error' ?
        `${label}: ${icon.names[language]}` : '';
    }

    const newToggle = document.getElementById('new-toggle');
    const newCount = icons.filter(icon => icon.isNew).length;

    newToggle.hidden = newCount === 0;
    newToggle.addEventListener('click', () => {
      categoryFilter.value = categoryFilter.value === 'new' ? 'all' : 'new';
      filterIcons();
    });

    function inCategory(icon, category) {
      return category === 'all' || (category === 'new' ? icon.isNew : icon.category === category);
    }

    /* Request an icon: a GitHub issue form, with the search text as the brand name. */
    const requestBase = 'https://github.com/cyclone9/CPIK/issues/new?template=icon-request.yml';
    const requestEmpty = document.getElementById('request-empty');
    const requestLink = document.getElementById('request-link');

    function requestUrl(brand) {
      const name = brand.trim();

      return name ?
        `${requestBase}&title=${encodeURIComponent(`${dictionary().requestTitle}: ${name}`)}` +
          `&brand=${encodeURIComponent(name)}` :
        requestBase;
    }

    function filterIcons() {
      const query = normalize(searchInput.value);
      const terms = query ? query.split(' ') : [];
      const category = categoryFilter.value;
      let visibleCount = 0;

      searchClear.hidden = searchInput.value.length === 0;

      for (const icon of icons) {
        const matches = inCategory(icon, category) &&
          terms.every(term => icon.searchText.includes(term));

        icon.element.hidden = !matches;
        visibleCount += matches;
      }

      results.textContent = dictionary().results(digits(visibleCount), digits(icons.length));
      emptyMessage.hidden = visibleCount > 0;
      requestEmpty.href = requestUrl(searchInput.value);
      requestLink.href = requestUrl(searchInput.value);
      newToggle.setAttribute('aria-pressed', String(category === 'new'));
      newToggle.textContent = dictionary().newFilter;
    }

    function clearSearch() {
      searchInput.value = '';
      searchInput.focus({ preventScroll: true });
      filterIcons();
    }

    async function copyText(text) {
      if (window.isSecureContext && navigator.clipboard?.writeText) {
        try {
          await navigator.clipboard.writeText(text);
          return;
        } catch { }
      }

      const activeElement = document.activeElement;
      const textarea = document.createElement('textarea');

      textarea.value = text;
      textarea.readOnly = true;
      textarea.className = 'sr-only';
      document.body.appendChild(textarea);

      try {
        textarea.select();

        if (!document.execCommand('copy')) {
          throw new Error('Copy failed');
        }
      } finally {
        textarea.remove();

        if (activeElement instanceof HTMLElement) {
          activeElement.focus({ preventScroll: true });
        }
      }
    }

    /*
     * One copy flow for icon cards and code blocks: busy, then copied or
     * failed, then back to idle.
     */
    async function runCopy(target, text, update) {
      if (target.busy) {
        return;
      }

      clearTimeout(target.resetTimer);
      target.busy = true;
      target.state = 'busy';
      update();

      try {
        await copyText(text);
        target.state = 'copied';
      } catch {
        target.state = 'error';
      } finally {
        target.busy = false;
        update();
        target.resetTimer = setTimeout(() => {
          target.state = 'idle';
          update();
        }, target.state === 'copied' ? 2500 : 4500);
      }
    }

    for (const icon of icons) {
      icon.copyButton.addEventListener('click', () =>
        runCopy(icon, icon.html, () => updateCopyButton(icon)));
      icon.openButton.addEventListener('click', () => openDetail(icon));
    }

    /*
     * Icon detail panel: a large preview with size and colour controls, the
     * class name and codepoint, and copy buttons. A native <dialog> keeps
     * focus inside while open, closes on Escape and restores focus after.
     */
    const dialog = document.getElementById('icon-dialog');
    const detailIcon = document.getElementById('detail-icon');
    const sizeInput = document.getElementById('detail-size');
    const sizeOutput = document.getElementById('detail-size-out');
    const colorInput = document.getElementById('detail-color');
    const detailFeedback = document.getElementById('detail-feedback');
    let current = null;

    const copyActions = Array.from(dialog.querySelectorAll('[data-copy]'), button => ({
      button,
      kind: button.dataset.copy,
      state: 'idle',
      busy: false,
      resetTimer: null
    }));

    function textColorHex() {
      const [r, g, b] = getComputedStyle(dialog).color.match(/\d+/g).map(Number);

      return `#${[r, g, b].map(value => value.toString(16).padStart(2, '0')).join('')}`;
    }

    function updateSize() {
      detailIcon.style.fontSize = `${sizeInput.value}px`;
      sizeOutput.textContent = `${sizeInput.value}px`;
    }

    const swatches = Array.from(dialog.querySelectorAll('.swatch'));

    function markSwatch(color) {
      for (const swatch of swatches) {
        swatch.setAttribute('aria-pressed', String(swatch.dataset.color.toLowerCase() === color));
      }
    }

    function resetColor() {
      detailIcon.style.color = '';
      colorInput.value = textColorHex();
      markSwatch('');
    }

    function copyValue(kind) {
      if (kind === 'class') return current.iconClass;
      if (kind === 'codepoint') return `\\${current.codepoint}`;
      return current.html;
    }

    function updateCopyAction(action) {
      const words = dictionary();
      const idle = { html: words.copyHtml, class: words.copyClass, codepoint: words.copyCodepoint }[action.kind];
      const label = action.state === 'copied' ? words.copiedShort :
        action.state === 'error' ? words.copyError : idle;

      action.button.dataset.state = action.state;
      action.button.textContent = label;
      detailFeedback.textContent = action.state === 'copied' || action.state === 'error' ? label : '';
    }

    function openDetail(icon) {
      const words = dictionary();
      const category = categories.find(item => item.prefix === icon.category);

      current = icon;
      document.getElementById('detail-title').textContent = icon.names[language];
      document.getElementById('detail-en').textContent = icon.names.en;
      document.getElementById('detail-class').textContent = icon.iconClass;
      document.getElementById('detail-codepoint').textContent =
        icon.codepoint ? `\\${icon.codepoint}  (U+${icon.codepoint.toUpperCase()})` : '';
      document.getElementById('detail-category').textContent = category ? category[language] : words.other;
      document.getElementById('detail-added').textContent = icon.added ? `v${icon.added}` : '';
      detailIcon.className = icon.iconClass;

      for (const action of copyActions) {
        clearTimeout(action.resetTimer);
        action.state = 'idle';
        action.busy = false;
        updateCopyAction(action);
      }

      dialog.showModal();
      resetColor();
      updateSize();
    }

    for (const action of copyActions) {
      action.button.addEventListener('click', () =>
        runCopy(action, copyValue(action.kind), () => updateCopyAction(action)));
    }

    sizeInput.addEventListener('input', updateSize);
    colorInput.addEventListener('input', () => {
      detailIcon.style.color = colorInput.value;
      markSwatch(colorInput.value.toLowerCase());
    });
    for (const swatch of swatches) {
      swatch.addEventListener('click', () => {
        detailIcon.style.color = swatch.dataset.color;
        colorInput.value = swatch.dataset.color.toLowerCase();
        markSwatch(colorInput.value);
      });
    }
    document.getElementById('detail-color-reset').addEventListener('click', resetColor);
    document.getElementById('detail-close').addEventListener('click', () => dialog.close());

    // A click on the backdrop (outside the panel's box) closes it.
    dialog.addEventListener('click', event => {
      const box = dialog.getBoundingClientRect();
      const outside = event.clientX < box.left || event.clientX > box.right ||
        event.clientY < box.top || event.clientY > box.bottom;

      if (event.target === dialog && outside) {
        dialog.close();
      }
    });

    const codeBlocks = Array.from(document.querySelectorAll('#guide pre'), pre => {
      const wrapper = document.createElement('div');
      const button = document.createElement('button');
      const feedback = document.createElement('span');
      const block = { button, feedback, state: 'idle', busy: false, resetTimer: null };

      wrapper.className = 'code-block';
      button.type = 'button';
      button.className = 'copy-button';
      button.innerHTML = icons[0]?.copyButton.innerHTML || '';
      feedback.className = 'sr-only';
      feedback.setAttribute('role', 'status');
      pre.before(wrapper);
      wrapper.append(pre, button, feedback);
      button.addEventListener('click', () =>
        runCopy(block, pre.textContent, () => updateCodeButton(block)));

      return block;
    });

    function updateCodeButton(block) {
      const label = {
        idle: dictionary().copyCode,
        busy: dictionary().copying,
        copied: dictionary().codeCopied,
        error: dictionary().copyFailed
      }[block.state];

      block.button.dataset.state = block.state;
      block.button.title = label;
      block.button.setAttribute('aria-label', label);
      block.feedback.textContent =
        block.state === 'copied' || block.state === 'error' ? label : '';
    }

    function updateThemeButton() {
      const label = dictionary()[root.dataset.theme === 'dark' ? 'lightMode' : 'darkMode'];

      themeToggle.title = label;
      themeToggle.setAttribute('aria-label', label);
    }

    function applyText() {
      const words = dictionary();

      document.querySelectorAll('[data-i18n]').forEach(element => {
        element.textContent = words[element.dataset.i18n];
      });

      document.querySelectorAll('[data-i18n-placeholder]').forEach(element => {
        element.placeholder = words[element.dataset.i18nPlaceholder];
      });

      document.querySelectorAll('.guide-step .num').forEach((element, index) => {
        element.textContent = digits(index + 1);
      });

      const detailClose = document.getElementById('detail-close');

      detailClose.title = words.close;
      detailClose.setAttribute('aria-label', words.close);

      for (const icon of icons) {
        icon.openButton.setAttribute('aria-label', `${words.details}: ${icon.names[language]}`);
        icon.openButton.title = `${words.details}: ${icon.names[language]}`;
        icon.nameElement.textContent = icon.names[language];
        icon.nameElement.title = icon.names[language];
        updateCopyButton(icon);
      }

      for (const block of codeBlocks) {
        updateCodeButton(block);
      }

      searchClear.title = words.clearSearch;
      searchClear.setAttribute('aria-label', words.clearSearch);
      backToTop.title = words.backToTop;
      backToTop.setAttribute('aria-label', words.backToTop);
      updateThemeButton();
      renderCategories();
      filterIcons();
    }

    themeToggle.addEventListener('click', () => {
      root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
      savePreference('cpik-preview-theme', root.dataset.theme);
      updateThemeButton();
    });

    searchInput.addEventListener('input', filterIcons);
    searchInput.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !event.isComposing) {
        event.preventDefault();
        clearSearch();
      }
    });
    searchClear.addEventListener('click', clearSearch);
    categoryFilter.addEventListener('change', filterIcons);

    /* Section navigation and the back-to-top button follow the scroll. */
    const sectionLinks = Array.from(document.querySelectorAll('.site-nav a[href^="#"]'));
    const sections = sectionLinks
      .map(link => document.getElementById(link.hash.slice(1)))
      .filter(Boolean);
    let frame = null;

    function updateNavigation() {
      frame = null;
      backToTop.hidden = window.scrollY < 400;

      let activeId = sections[0]?.id;

      for (const section of sections) {
        if (section.getBoundingClientRect().top <= window.innerHeight * 0.35) {
          activeId = section.id;
        }
      }

      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        activeId = sections[sections.length - 1]?.id;
      }

      for (const link of sectionLinks) {
        if (link.hash === `#${activeId}`) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      }
    }

    function scheduleNavigation() {
      frame ??= requestAnimationFrame(updateNavigation);
    }

    backToTop.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      window.scrollTo({ top: 0, behavior: reduceMotion ? 'instant' : 'smooth' });
    });

    window.addEventListener('scroll', scheduleNavigation, { passive: true });
    window.addEventListener('resize', scheduleNavigation);
    scheduleNavigation();
    applyText();
  </script>
</body>
</html>
